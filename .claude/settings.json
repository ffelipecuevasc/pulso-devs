{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm preview)",
      "Bash(pnpm check)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm astro dev status)",
      "Bash(pnpm astro dev logs)",
      "Bash(pnpm astro dev stop)",
      "Bash(pnpm why *)",
      "Bash(pnpm list *)",
      "Bash(pnpm outdated)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch --show-current)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Read(**)",
      "Edit(src/**)",
      "Edit(public/**)",
      "Edit(_planificacion/**)",
      "Edit(src/**)",
      "Edit(public/**)",
      "Edit(_planificacion/**)"
    ],
    "deny": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git pull *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git tag *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(wrangler *)",
      "Bash(pnpm exec wrangler *)",
      "Bash(pnpm dlx wrangler *)",
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.dev.vars)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(.dev.vars)",
      "Edit(.claude/**)",
      "Edit(.git/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(.dev.vars)",
      "Edit(.claude/**)",
      "Edit(.git/**)"
    ]
  }
}
