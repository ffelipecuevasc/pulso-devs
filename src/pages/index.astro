---
import LayoutBase from '../layouts/LayoutBase.astro';
---

<LayoutBase>
  <main id="contenido">
    <section id="inicio" aria-labelledby="hero-title">
      <h1 id="hero-title">Comunidad Pulso Devs</h1>
    </section>

    <section id="comunidad" aria-labelledby="about-title">
      <h2 id="about-title">Un lugar para no aprender en solitario.</h2>
    </section>

    <section id="encontraras" aria-labelledby="offer-title">
      <h2 id="offer-title">Lo que encontrarás en Pulso Devs</h2>
    </section>

    <section id="talleres" aria-labelledby="workshops-title">
      <h2 id="workshops-title">Talleres gratuitos en vivo</h2>
    </section>

    <section id="vision" aria-labelledby="vision-title">
      <h2 id="vision-title">Esto recién comienza.</h2>
    </section>

    <section id="unete" aria-labelledby="join-title">
      <h2 id="join-title">¿Quieres formar parte?</h2>
    </section>
  </main>
</LayoutBase>
